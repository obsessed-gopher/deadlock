            "type": "object",
            "$ref": "#/definitions/v1StatSnapshot"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ItemEvent"
          }
        },
        "deaths": {
