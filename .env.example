# copy to .env (docker compose reads it automatically)
SYNC_ACCOUNTS=1517505834
SYNC_EVERY=30m
META_INTERVAL=1.5s
# optional deadlock-api key (Patreon supporters): salts from Steam at
# 300/hour instead of 3/hour, so new matches get metadata much sooner
DEADLOCK_API_KEY=
# optional Steam bot for the Deadlock Game Coordinator: fresh match history
# and salts first-hand. Set up with: go run ./tools/steambot login
# (a separate Steam account with Deadlock, added to your friends)
STEAM_BOT_USER=
STEAM_BOT_TOKEN=
# time zone for dates in the web UI (IANA name)
TZ=UTC
