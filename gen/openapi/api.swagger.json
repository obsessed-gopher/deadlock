        },
        "matchesTotal": {
          "type": "integer",
          "format": "int64"
        },
        "matchesWithMeta": {
          "type": "integer",
          "format": "int64"
        },
        "matchesPending": {
          "type": "integer",
          "format": "int64"
        },
        "wins": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1PlayerMatch": {
      "type": "object",
      "properties": {
        "match": {
          "$ref": "#/definitions/v1Match",
          "title": "scoreboard, so one call renders the page"
        },
        "slot": {
          "type": "integer",
          "format": "int64"
        },
        "timeline": {
          "type": "array",
