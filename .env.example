# copy to .env (docker compose reads it automatically)
SYNC_ACCOUNTS=1517505834
SYNC_EVERY=30m
META_INTERVAL=1.5s
# optional deadlock-api key (Patreon supporters): salts from Steam at
# 300/hour instead of 3/hour, so new matches get metadata much sooner
DEADLOCK_API_KEY=
# time zone for dates in the web UI (IANA name)
TZ=UTC
