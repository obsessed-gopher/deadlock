{
  "swagger": "2.0",
  "info": {
    "title": "deadlock/v1/stats.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "StatsService",
      "description": "StatsService serves per-player and per-match analytics built from Valve\nmatch metadata. REST mapping is provided by grpc-gateway."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/gamedata": {
      "get": {
        "summary": "Static game data: hero and item/ability names, slots, tiers.\nChanges only with game patches; clients should cache it.",
        "operationId": "StatsService_GetGameData",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GameData"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/matches/{matchId}": {
      "get": {
        "summary": "Scoreboard of all players in a match.",
        "operationId": "StatsService_GetMatch",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Match"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/matches/{matchId}/players/{accountId}": {
      "get": {
        "summary": "Detailed breakdown of one player in one match: timelines, items, deaths.",
        "operationId": "StatsService_GetPlayerMatch",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PlayerMatch"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          },
          {
            "name": "accountId",
            "description": "Account id or SteamID64. Widened from uint32, which is wire-compatible.",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/players/{accountId}": {
      "get": {
        "summary": "Player profile and sync state.",
        "operationId": "StatsService_GetPlayer",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Player"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "description": "Account id or SteamID64. Widened from uint32, which is wire-compatible.",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/players/{accountId}/facts": {
      "get": {
        "summary": "Compact facts of every match of a player, oldest first: the input of\nclient-side trends (progress, development speed, sessions, records).",
        "operationId": "StatsService_ListPlayerMatchFacts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPlayerMatchFactsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "description": "Account id or SteamID64.",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/players/{accountId}/heroes": {
      "get": {
        "summary": "Per-hero totals of a player over all synced matches, most played first.",
        "operationId": "StatsService_ListPlayerHeroStats",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPlayerHeroStatsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "description": "Account id or SteamID64.",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/players/{accountId}/matches": {
      "get": {
        "summary": "Player's match history, newest first.",
        "operationId": "StatsService_ListPlayerMatches",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPlayerMatchesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "description": "Account id or SteamID64. Widened from uint32, which is wire-compatible.",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          },
          {
            "name": "pageSize",
            "description": "default 50, max 200",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "pageToken",
            "description": "opaque, from previous response",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "heroId",
            "description": "optional filter",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "sort",
            "description": " - MATCH_SORT_UNSPECIFIED: same as START_TIME",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "MATCH_SORT_UNSPECIFIED",
              "MATCH_SORT_START_TIME",
              "MATCH_SORT_DURATION",
              "MATCH_SORT_KILLS",
              "MATCH_SORT_DEATHS",
              "MATCH_SORT_ASSISTS",
              "MATCH_SORT_NET_WORTH",
              "MATCH_SORT_LAST_HITS",
              "MATCH_SORT_HERO_LEVEL"
            ],
            "default": "MATCH_SORT_UNSPECIFIED"
          },
          {
            "name": "ascending",
            "description": "default: largest / newest first",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "result",
            "description": "optional filter\n\n - MATCH_RESULT_UNSPECIFIED: any",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "MATCH_RESULT_UNSPECIFIED",
              "MATCH_RESULT_WIN",
              "MATCH_RESULT_LOSS"
            ],
            "default": "MATCH_RESULT_UNSPECIFIED"
          },
          {
            "name": "gameMode",
            "description": "optional filter, 0 = any",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "metaStatus",
            "description": "optional filter, UNSPECIFIED = any\n\n - META_STATUS_PENDING: queued for download\n - META_STATUS_OK: parsed and stored\n - META_STATUS_EXPIRED: Valve no longer hosts the replay\n - META_STATUS_FAILED: gave up after retries",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "META_STATUS_UNSPECIFIED",
              "META_STATUS_PENDING",
              "META_STATUS_OK",
              "META_STATUS_EXPIRED",
              "META_STATUS_FAILED"
            ],
            "default": "META_STATUS_UNSPECIFIED"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/players/{accountId}:sync": {
      "post": {
        "summary": "Pull fresh match history and queue metadata downloads for new matches.",
        "operationId": "StatsService_SyncPlayer",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SyncPlayerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "description": "Account id or SteamID64. Widened from uint32, which is wire-compatible.",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/StatsServiceSyncPlayerBody"
            }
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    }
  },
  "definitions": {
    "StatsServiceSyncPlayerBody": {
      "type": "object"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Ability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "title": "value of item_id in match data"
        },
        "key": {
          "type": "string",
          "title": "e.g. \"upgrade_rapid_rounds\""
        },
        "name": {
          "type": "string"
        },
        "nameRu": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "item | signature | weapon | innate | ..."
        },
        "slot": {
          "type": "string",
          "title": "weapon | vitality | spirit (items only)"
        },
        "tier": {
          "type": "integer",
          "format": "int64",
          "title": "1..5 (items only)"
        }
      }
    },
    "v1Death": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "format": "int64"
        },
        "killerSlot": {
          "type": "integer",
          "format": "int64"
        },
        "pos": {
          "$ref": "#/definitions/v1Vec3"
        },
        "killerPos": {
          "$ref": "#/definitions/v1Vec3"
        },
        "respawnS": {
          "type": "integer",
          "format": "int64"
        },
        "timeToKillS": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "v1GameData": {
      "type": "object",
      "properties": {
        "gameVersion": {
          "type": "string"
        },
        "heroes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Hero"
          }
        },
        "abilities": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Ability"
          }
        }
      }
    },
    "v1Hero": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "key": {
          "type": "string",
          "title": "internal name, e.g. \"hero_haze\""
        },
        "name": {
          "type": "string"
        },
        "nameRu": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "title": "e.g. \"assassin\""
        },
        "playable": {
          "type": "boolean",
          "title": "released and enabled"
        }
      }
    },
    "v1HeroStats": {
      "type": "object",
      "properties": {
        "heroId": {
          "type": "integer",
          "format": "int64"
        },
        "matches": {
          "type": "integer",
          "format": "int64"
        },
        "wins": {
          "type": "integer",
          "format": "int64"
        },
        "kills": {
          "type": "integer",
          "format": "int64"
        },
        "deaths": {
          "type": "integer",
          "format": "int64"
        },
        "assists": {
          "type": "integer",
          "format": "int64"
        },
        "netWorth": {
          "type": "integer",
          "format": "int64"
        },
        "lastHits": {
          "type": "integer",
          "format": "int64"
        },
        "durationS": {
          "type": "integer",
          "format": "int64",
          "title": "total time played"
        },
        "lastPlayed": {
          "type": "string",
          "format": "int64",
          "title": "unix seconds, start of the latest match"
        }
      },
      "description": "Totals over the player's matches on one hero; averages are total / matches."
    },
    "v1ItemEvent": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "format": "int64"
        },
        "itemId": {
          "type": "integer",
          "format": "int64"
        },
        "soldT": {
          "type": "integer",
          "format": "int64",
          "title": "0 if kept"
        },
        "upgradeId": {
          "type": "integer",
          "format": "int64"
        },
        "flags": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1ListPlayerHeroStatsResponse": {
      "type": "object",
      "properties": {
        "heroes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1HeroStats"
          }
        }
      }
    },
    "v1ListPlayerMatchFactsResponse": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MatchFacts"
          },
          "title": "oldest first"
        },
        "soulMarksS": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "title": "game times of MatchFacts.souls_at"
        },
        "soulTargets": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "title": "soul totals of MatchFacts.time_to_souls_s"
        }
      }
    },
    "v1ListPlayerMatchesResponse": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1PlayerMatchRow"
          }
        },
        "nextPageToken": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "format": "int64",
          "title": "rows matching the filters, all pages"
        }
      }
    },
    "v1Match": {
      "type": "object",
      "properties": {
        "matchId": {
          "type": "string",
          "format": "uint64"
        },
        "startTime": {
          "type": "string",
          "format": "int64"
        },
        "durationS": {
          "type": "integer",
          "format": "int64"
        },
        "gameMode": {
          "type": "integer",
          "format": "int32"
        },
        "matchMode": {
          "type": "integer",
          "format": "int32"
        },
        "winningTeam": {
          "type": "integer",
          "format": "int32"
        },
        "metaStatus": {
          "$ref": "#/definitions/v1MetaStatus"
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MatchPlayer"
          }
        }
      }
    },
    "v1MatchFacts": {
      "type": "object",
      "properties": {
        "matchId": {
          "type": "string",
          "format": "uint64"
        },
        "startTime": {
          "type": "string",
          "format": "int64",
          "title": "unix seconds"
        },
        "durationS": {
          "type": "integer",
          "format": "int64"
        },
        "gameMode": {
          "type": "integer",
          "format": "int32"
        },
        "matchMode": {
          "type": "integer",
          "format": "int32"
        },
        "heroId": {
          "type": "integer",
          "format": "int64"
        },
        "won": {
          "type": "boolean"
        },
        "kills": {
          "type": "integer",
          "format": "int64"
        },
        "deaths": {
          "type": "integer",
          "format": "int64"
        },
        "assists": {
          "type": "integer",
          "format": "int64"
        },
        "netWorth": {
          "type": "integer",
          "format": "int64"
        },
        "lastHits": {
          "type": "integer",
          "format": "int64"
        },
        "hasMeta": {
          "type": "boolean",
          "description": "The rest comes from metadata: zero when has_meta is false."
        },
        "playerDamage": {
          "type": "integer",
          "format": "int64"
        },
        "playerHealing": {
          "type": "integer",
          "format": "int64"
        },
        "soulsAt": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "description": "Net worth at each soul_marks_s; 0 when the match ended earlier."
        },
        "timeToSoulsS": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "description": "Seconds to reach each soul_targets; 0 when never reached."
        },
        "soulsFrom": {
          "$ref": "#/definitions/v1SoulSources"
        },
        "lobbyBadge": {
          "type": "integer",
          "format": "int64",
          "description": "Average rank badge of both teams (tier * 10 + subtier); 0 = not reported.\nValve writes no per-player rank into metadata."
        }
      }
    },
    "v1MatchPlayer": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "integer",
          "format": "int64"
        },
        "accountId": {
          "type": "integer",
          "format": "int64"
        },
        "team": {
          "type": "integer",
          "format": "int32"
        },
        "heroId": {
          "type": "integer",
          "format": "int64"
        },
        "lane": {
          "type": "integer",
          "format": "int64"
        },
        "kills": {
