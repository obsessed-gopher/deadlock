{
  "swagger": "2.0",
  "info": {
    "title": "deadlock/v1/stats.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "StatsService",
      "description": "StatsService serves per-player and per-match analytics built from Valve\nmatch metadata. REST mapping is provided by grpc-gateway."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/gamedata": {
      "get": {
        "summary": "Static game data: hero and item/ability names, slots, tiers.\nChanges only with game patches; clients should cache it.",
        "operationId": "StatsService_GetGameData",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GameData"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/matches/{matchId}": {
      "get": {
        "summary": "Scoreboard of all players in a match.",
        "operationId": "StatsService_GetMatch",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Match"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/matches/{matchId}/players/{accountId}": {
      "get": {
        "summary": "Detailed breakdown of one player in one match: timelines, items, deaths.",
        "operationId": "StatsService_GetPlayerMatch",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1PlayerMatch"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uint64"
          },
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/players/{accountId}": {
      "get": {
        "summary": "Player profile and sync state.",
        "operationId": "StatsService_GetPlayer",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1Player"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/players/{accountId}/matches": {
      "get": {
        "summary": "Player's match history, newest first.",
        "operationId": "StatsService_ListPlayerMatches",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPlayerMatchesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "pageSize",
            "description": "default 50, max 200",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "pageToken",
            "description": "opaque, from previous response",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "heroId",
            "description": "optional filter",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int64"
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    },
    "/v1/players/{accountId}:sync": {
      "post": {
        "summary": "Pull fresh match history and queue metadata downloads for new matches.",
        "operationId": "StatsService_SyncPlayer",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SyncPlayerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/StatsServiceSyncPlayerBody"
            }
          }
        ],
        "tags": [
          "StatsService"
        ]
      }
    }
  },
  "definitions": {
    "StatsServiceSyncPlayerBody": {
      "type": "object"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Ability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "title": "value of item_id in match data"
        },
        "key": {
          "type": "string",
          "title": "e.g. \"upgrade_rapid_rounds\""
        },
        "name": {
          "type": "string"
        },
        "nameRu": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "item | signature | weapon | innate | ..."
        },
        "slot": {
          "type": "string",
          "title": "weapon | vitality | spirit (items only)"
        },
        "tier": {
          "type": "integer",
          "format": "int64",
          "title": "1..5 (items only)"
        }
      }
    },
    "v1Death": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "format": "int64"
        },
        "killerSlot": {
          "type": "integer",
          "format": "int64"
        },
        "pos": {
          "$ref": "#/definitions/v1Vec3"
        },
        "killerPos": {
          "$ref": "#/definitions/v1Vec3"
        },
        "respawnS": {
          "type": "integer",
          "format": "int64"
        },
        "timeToKillS": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "v1GameData": {
      "type": "object",
      "properties": {
        "gameVersion": {
          "type": "string"
        },
        "heroes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Hero"
          }
        },
        "abilities": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Ability"
          }
        }
      }
    },
    "v1Hero": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "key": {
          "type": "string",
          "title": "internal name, e.g. \"hero_haze\""
        },
        "name": {
          "type": "string"
        },
        "nameRu": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "title": "e.g. \"assassin\""
        },
        "playable": {
          "type": "boolean",
          "title": "released and enabled"
        }
      }
    },
    "v1ItemEvent": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "format": "int64"
        },
        "itemId": {
          "type": "integer",
          "format": "int64"
        },
        "soldT": {
          "type": "integer",
          "format": "int64",
          "title": "0 if kept"
        },
        "upgradeId": {
          "type": "integer",
          "format": "int64"
        },
        "flags": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1ListPlayerMatchesResponse": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1PlayerMatchRow"
          }
        },
        "nextPageToken": {
          "type": "string"
        }
      }
    },
    "v1Match": {
      "type": "object",
      "properties": {
        "matchId": {
          "type": "string",
          "format": "uint64"
        },
        "startTime": {
          "type": "string",
          "format": "int64"
        },
        "durationS": {
          "type": "integer",
          "format": "int64"
        },
        "gameMode": {
          "type": "integer",
          "format": "int32"
        },
        "matchMode": {
          "type": "integer",
          "format": "int32"
        },
        "winningTeam": {
          "type": "integer",
          "format": "int32"
        },
        "metaStatus": {
          "$ref": "#/definitions/v1MetaStatus"
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1MatchPlayer"
          }
        }
      }
    },
    "v1MatchPlayer": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "integer",
          "format": "int64"
        },
        "accountId": {
          "type": "integer",
          "format": "int64"
        },
        "team": {
          "type": "integer",
          "format": "int32"
        },
        "heroId": {
          "type": "integer",
          "format": "int64"
        },
        "lane": {
          "type": "integer",
          "format": "int64"
        },
        "kills": {
          "type": "integer",
          "format": "int64"
        },
        "deaths": {
          "type": "integer",
          "format": "int64"
        },
        "assists": {
          "type": "integer",
          "format": "int64"
        },
        "netWorth": {
          "type": "integer",
          "format": "int64"
        },
        "lastHits": {
          "type": "integer",
          "format": "int64"
        },
        "denies": {
          "type": "integer",
          "format": "int64"
        },
        "level": {
          "type": "integer",
          "format": "int64"
        },
        "playerDamage": {
          "type": "integer",
          "format": "int64"
        },
        "playerHealing": {
          "type": "integer",
          "format": "int64"
        },
        "abandonTimeS": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1MetaStatus": {
      "type": "string",
      "enum": [
        "META_STATUS_UNSPECIFIED",
        "META_STATUS_PENDING",
        "META_STATUS_OK",
        "META_STATUS_EXPIRED",
        "META_STATUS_FAILED"
      ],
      "default": "META_STATUS_UNSPECIFIED",
      "description": "- META_STATUS_PENDING: queued for download\n - META_STATUS_OK: parsed and stored\n - META_STATUS_EXPIRED: Valve no longer hosts the replay\n - META_STATUS_FAILED: gave up after retries"
    },
    "v1Player": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "integer",
          "format": "int64"
        },
        "syncState": {
          "$ref": "#/definitions/v1SyncState"
        },
        "syncError": {
          "type": "string"
        },
        "lastSyncedAt": {
          "type": "string",
          "format": "int64",
          "title": "unix seconds, 0 if never"
        },
        "matchesTotal": {
          "type": "integer",
          "format": "int64"
        },
        "matchesWithMeta": {
          "type": "integer",
          "format": "int64"
        },
        "matchesPending": {
          "type": "integer",
          "format": "int64"
        },
        "wins": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1PlayerMatch": {
      "type": "object",
      "properties": {
        "match": {
          "$ref": "#/definitions/v1Match",
          "title": "scoreboard, so one call renders the page"
        },
        "slot": {
          "type": "integer",
          "format": "int64"
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1StatSnapshot"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ItemEvent"
          }
        },
        "deaths": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Death"
          }
        },
        "netWorthBySlot": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SlotTimeline"
          },
          "description": "Net worth timelines of every player, keyed by slot, for comparison charts."
        }
      }
    },
    "v1PlayerMatchRow": {
      "type": "object",
      "properties": {
        "matchId": {
          "type": "string",
          "format": "uint64"
        },
        "startTime": {
          "type": "string",
          "format": "int64",
          "title": "unix seconds"
        },
        "durationS": {
          "type": "integer",
          "format": "int64"
        },
        "gameMode": {
          "type": "integer",
          "format": "int32"
        },
        "matchMode": {
          "type": "integer",
          "format": "int32"
        },
        "heroId": {
          "type": "integer",
          "format": "int64"
        },
        "team": {
          "type": "integer",
          "format": "int32"
        },
        "won": {
          "type": "boolean"
        },
        "kills": {
          "type": "integer",
          "format": "int64"
        },
        "deaths": {
          "type": "integer",
          "format": "int64"
        },
        "assists": {
          "type": "integer",
          "format": "int64"
        },
        "netWorth": {
          "type": "integer",
          "format": "int64"
        },
        "lastHits": {
          "type": "integer",
          "format": "int64"
        },
        "denies": {
          "type": "integer",
          "format": "int64"
        },
        "heroLevel": {
          "type": "integer",
          "format": "int64"
        },
        "metaStatus": {
          "$ref": "#/definitions/v1MetaStatus"
        }
      }
    },
    "v1SlotTimeline": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "integer",
          "format": "int64"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1TimePoint"
          }
        }
      }
    },
    "v1StatSnapshot": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "format": "int64",
          "title": "game time, seconds"
        },
        "netWorth": {
          "type": "integer",
          "format": "int64"
        },
        "level": {
          "type": "integer",
          "format": "int64"
        },
        "kills": {
          "type": "integer",
          "format": "int64"
        },
        "deaths": {
          "type": "integer",
          "format": "int64"
        },
        "assists": {
          "type": "integer",
          "format": "int64"
        },
        "creepKills": {
          "type": "integer",
          "format": "int64"
        },
        "neutralKills": {
          "type": "integer",
          "format": "int64"
        },
        "denies": {
          "type": "integer",
          "format": "int64"
        },
        "playerDamage": {
          "type": "integer",
          "format": "int64"
        },
        "playerDamageTaken": {
          "type": "integer",
          "format": "int64"
        },
        "playerHealing": {
          "type": "integer",
          "format": "int64"
        },
        "selfHealing": {
          "type": "integer",
          "format": "int64"
        },
        "goldPlayer": {
          "type": "integer",
          "format": "int64",
          "title": "souls from hero kills"
        },
        "goldLaneCreep": {
          "type": "integer",
          "format": "int64"
        },
        "goldNeutralCreep": {
          "type": "integer",
          "format": "int64"
        },
        "goldBoss": {
          "type": "integer",
          "format": "int64"
        },
        "goldTreasure": {
          "type": "integer",
          "format": "int64"
        },
        "goldDeathLoss": {
          "type": "integer",
          "format": "int64"
        },
        "shotsHit": {
          "type": "integer",
          "format": "int64"
        },
        "shotsMissed": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1SyncPlayerResponse": {
      "type": "object",
      "properties": {
        "newMatches": {
          "type": "integer",
          "format": "int64"
        },
        "queuedMeta": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1SyncState": {
      "type": "string",
      "enum": [
        "SYNC_STATE_UNSPECIFIED",
        "SYNC_STATE_NEVER",
        "SYNC_STATE_RUNNING",
        "SYNC_STATE_IDLE",
        "SYNC_STATE_ERROR"
      ],
      "default": "SYNC_STATE_UNSPECIFIED"
    },
    "v1TimePoint": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "format": "int64"
        },
        "v": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1Vec3": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "z": {
          "type": "number",
          "format": "float"
        }
      }
    }
  }
}
